# Copy this file to .env in your video project and fill in what you use. .env is git-ignored: never commit it.

# Optional. Only for new music (scripts/music.mjs, Google Lyria through OpenRouter). Billed to this key.
# Get one at https://openrouter.ai/keys and set a monthly credit limit there.
OPENROUTER_API_KEY=

# Optional. Paths to a full ffmpeg and ffprobe, if the ones on your PATH lack the analysis filters review.mjs uses.
# FFMPEG=/opt/homebrew/bin/ffmpeg
# FFPROBE=/opt/homebrew/bin/ffprobe
